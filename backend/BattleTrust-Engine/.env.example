ESCROW_WINNERS_PERCENT=85.00
DB_URL=jdbc:mysql://localhost:3306/bte?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
ADMIN_EMAIL=admin@battletrust.local
ADMIN_PASSWORD=
# Alternate supported names: ADMIN_DEFAULT_EMAIL / ADMIN_DEFAULT_PASSWORD
# Compatibility setting; automatic demo tournaments and funds are no longer seeded.
DEV_SEED_DATA=false
ESCROW_LEADER_PERCENT=10.00
ESCROW_PLATFORM_PERCENT=5.00
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
WALLET_MINIMUM_WITHDRAWAL=100.00
WALLET_MAXIMUM_WITHDRAWAL=1000000.00
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_here
SPRING_MAIL_PASSWORD=your_app_password_here

# Development mail is disabled until a real SMTP server is configured.
MAIL_ENABLED=false

# Only the dev profile can expose simulated 1Bill payments; production always excludes the controller.
PAYMENT_SIMULATION_ENABLED=true
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

